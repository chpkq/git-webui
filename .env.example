# Docker Compose 必填：至少 12 个字符，且不要提交真实密码。
GIT_WEBUI_AUTH_PASSWORD=replace-with-a-long-password

# Docker Compose 必填：至少 32 个字符，建议使用密码管理器随机生成。
GIT_WEBUI_SESSION_SECRET=replace-with-a-random-secret-at-least-32-chars

# 宿主机 Git 工作区目录，容器内固定映射到 /workspaces。
GIT_WEBUI_WORKSPACES=/absolute/path/to/workspaces

# 容器进程 UID/GID；应与宿主机工作区所有者一致，避免 Git 写入 root-owned 文件。
GIT_WEBUI_UID=1000
GIT_WEBUI_GID=1000

# Standalone/pnpm 方式使用的路径；Docker Compose 会使用容器内的固定路径。
GIT_WEBUI_ALLOWED_ROOTS=/absolute/path/to/workspaces
GIT_WEBUI_DATABASE=/absolute/path/to/git-webui/data.sqlite

# Web 容器绑定地址；HTTPS 反向代理场景可保持为 127.0.0.1。
GIT_WEBUI_WEB_BIND=127.0.0.1:8080

# 直接使用 HTTP 时为 false；HTTPS 反向代理已正确传递安全 Cookie 时改为 true。
GIT_WEBUI_COOKIE_SECURE=false
