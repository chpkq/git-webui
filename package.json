{
  "name": "git-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "git-webui": "./bin/git-webui.mjs"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @git-webui/shared build && pnpm --filter @git-webui/git-core build && pnpm --filter @git-webui/ui-components build",
    "package:standalone": "pnpm build && node scripts/package-standalone.mjs",
    "dev": "pnpm build:packages && pnpm --parallel --filter @git-webui/server --filter @git-webui/web dev",
    "start": "node bin/git-webui.mjs start",
    "stop": "node bin/git-webui.mjs stop",
    "restart": "node bin/git-webui.mjs restart",
    "status": "node bin/git-webui.mjs status",
    "logs": "node bin/git-webui.mjs logs",
    "startup:enable": "node bin/git-webui.mjs startup enable",
    "startup:disable": "node bin/git-webui.mjs startup disable",
    "startup:status": "node bin/git-webui.mjs startup status",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^24.2.0",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
